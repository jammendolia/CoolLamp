diff --git a/ios/Sources/BluetoothLe/WriteWithoutResponseGate.swift b/ios/Sources/BluetoothLe/WriteWithoutResponseGate.swift
new file mode 100644
index 0000000000000000000000000000000000000000..bd4cf2748b6f911d264494d114db8452e262cce0
--- /dev/null
+++ b/ios/Sources/BluetoothLe/WriteWithoutResponseGate.swift
@@ -0,0 +1,97 @@
+import Foundation
+import Dispatch
+
+// All calls run on the SDK's existing main queue. Native completion means that
+// CoreBluetooth accepted a submission; the firmware still confirms written bytes.
+final class WriteWithoutResponseGate {
+    typealias Completion = (_ success: Bool, _ message: String) -> Void
+    typealias CancelTimeout = () -> Void
+    typealias ScheduleTimeout = (_ delay: Double, _ action: @escaping () -> Void) -> CancelTimeout
+
+    private struct Pending {
+        let owner: UInt64
+        let isCurrent: () -> Bool
+        let canSend: () -> Bool
+        let submit: () -> Void
+        let completion: Completion
+        var cancelTimeout: CancelTimeout = {}
+    }
+
+    private var nextOwner: UInt64 = 0
+    private var pending: Pending?
+    private let scheduleTimeout: ScheduleTimeout
+
+    init(scheduleTimeout: @escaping ScheduleTimeout = { delay, action in
+        let work = DispatchWorkItem(block: action)
+        DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: work)
+        return { work.cancel() }
+    }) {
+        self.scheduleTimeout = scheduleTimeout
+    }
+
+    var hasPendingWrite: Bool { pending != nil }
+
+    func write(
+        timeout: Double,
+        isCurrent: @escaping () -> Bool,
+        canSend: @escaping () -> Bool,
+        submit: @escaping () -> Void,
+        completion: @escaping Completion
+    ) {
+        guard pending == nil else {
+            completion(false, "Another write without response is pending.")
+            return
+        }
+        guard timeout.isFinite && timeout > 0 else {
+            completion(false, "Invalid write without response timeout.")
+            return
+        }
+        guard isCurrent() else {
+            completion(false, "Peripheral disconnected or replaced.")
+            return
+        }
+        nextOwner &+= 1
+        let owner = nextOwner
+        pending = Pending(owner: owner, isCurrent: isCurrent, canSend: canSend,
+                          submit: submit, completion: completion)
+        ready()
+        guard pending?.owner == owner else { return }
+        // Keep readiness waits bounded even when a caller supplies an excessive timeout.
+        let cancelTimeout = scheduleTimeout(min(timeout, 60)) { [weak self] in
+            self?.finish(owner: owner, success: false, message: "Write without response readiness timeout.")
+        }
+        if pending?.owner == owner {
+            pending?.cancelTimeout = cancelTimeout
+        } else {
+            cancelTimeout()
+        }
+    }
+
+    func ready() {
+        guard let request = pending else { return }
+        guard request.isCurrent() else {
+            finish(owner: request.owner, success: false, message: "Peripheral disconnected or replaced.")
+            return
+        }
+        guard pending?.owner == request.owner, request.canSend(),
+              pending?.owner == request.owner else { return }
+        // Clear ownership before submission/completion; neither a late timer nor
+        // a callback that starts a new request may remove that newer request.
+        pending = nil
+        request.cancelTimeout()
+        request.submit()
+        request.completion(true, "Successfully queued value without response.")
+    }
+
+    func cancel(_ message: String = "Write without response cancelled.") {
+        guard let owner = pending?.owner else { return }
+        finish(owner: owner, success: false, message: message)
+    }
+
+    private func finish(owner: UInt64, success: Bool, message: String) {
+        guard let request = pending, request.owner == owner else { return }
+        pending = nil
+        request.cancelTimeout()
+        request.completion(success, message)
+    }
+}
